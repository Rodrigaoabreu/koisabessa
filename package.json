{
  "name": "koisabessa",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "test": "npm run test -w backend",
    "test:e2e": "playwright test",
    "db:migrate": "npm run db:migrate -w backend",
    "db:rollback": "npm run db:rollback -w backend",
    "db:seed": "npm run db:seed -w backend"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.2.1"
  }
}
