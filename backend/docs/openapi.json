{
  "openapi": "3.0.3",
  "info": {
    "title": "Koisabessa · API",
    "version": "1.0.0",
    "description": "API REST do catálogo e das contas da Koisabessa. Leituras de catálogo, cadastro e login são públicos. O titular gerencia sua conta e um administrador gerencia o catálogo. Em rotas protegidas uma falha no JWT retorna 401, conforme os códigos individuais do enunciado."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/v1/user": {
      "post": {
        "tags": [
          "Usuários"
        ],
        "summary": "Cadastrar usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              },
              "example": {
                "firstname": "Maria",
                "surname": "Silva",
                "email": "maria@example.com",
                "password": "MinhaSenha123!",
                "confirmPassword": "MinhaSenha123!"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Limite de tentativas atingido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/user/token": {
      "post": {
        "tags": [
          "Usuários"
        ],
        "summary": "Entrar e obter JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              },
              "example": {
                "email": "maria@example.com",
                "password": "MinhaSenha123!"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
