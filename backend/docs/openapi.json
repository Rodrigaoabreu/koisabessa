    "/v1/product/search": {
      "get": {
        "tags": [
          "Produtos"
        ],
        "summary": "Pesquisar produtos publicados",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "default": 12
            },
            "description": "Itens por página. Use -1 para todos."
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            },
            "description": "Página iniciada em 1."
          },
          {
            "in": "query",
            "name": "fields",
            "schema": {
              "type": "string"
            },
            "description": "Campos da resposta separados por vírgula."
          },
          {
            "in": "query",
            "name": "match",
            "schema": {
              "type": "string"
            },
            "description": "Trecho do nome ou descrição."
          },
          {
            "in": "query",
            "name": "category_ids",
            "schema": {
              "type": "string",
              "example": "1,2"
            },
            "description": "IDs de categoria separados por vírgula."
          },
          {
            "in": "query",
            "name": "price-range",
            "schema": {
              "type": "string",
              "example": "100-200"
            },
            "description": "Intervalo inclusivo do preço efetivo em reais."
          },
          {
            "in": "query",
            "name": "option[1]",
            "schema": {
              "type": "string",
              "example": "Linho,Algodão"
            },
            "description": "Substitua 1 pelo ID da opção e informe valores separados por vírgula."
          },
          {
            "in": "query",
            "name": "sort",
            "schema": {
              "type": "string",
              "enum": [
                "price-asc",
                "price-desc"
              ]
            },
            "description": "Ordenação por preço efetivo antes da paginação. Por padrão, ID crescente."
          }
        ],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductPage"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Token informado é inválido ou expirou",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {},
          {
            "bearerAuth": []
          }
        ],
        "description": "Com um token de administrador, inclui produtos e imagens desativados."
      }
    },
    "/v1/product": {
      "post": {
        "tags": [
          "Produtos"
        ],
        "summary": "Criar produto como administrador",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductCreate"
              },
              "example": {
                "enabled": true,
                "name": "Poltrona Brisa",
                "slug": "poltrona-brisa",
                "stock": 8,
                "description": "Estrutura de madeira e assento em bouclé.",
                "price": 1199.9,
                "price_with_discount": 999.9,
                "category_ids": [
                  1
                ],
                "images": [
                  {
                    "content": "https://example.com/poltrona.jpg"
                  }
                ],
                "options": [
                  {
                    "title": "Cor",
                    "type": "color",
                    "shape": "circle",
                    "values": [
                      "#676c48",
                      "#d8cbb4"
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Criado",
            "content": {
